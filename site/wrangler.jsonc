{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Landing pública independiente del Worker de Discord. Sin acceso a D1.
  "name": "bardo-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
