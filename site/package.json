{
  "name": "bardo-site",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Landing pública de Bardo.",
  "scripts": {
    "refresh:captures": "node scripts/refresh-captures.mjs",
    "verify:captures": "node scripts/verify-captures.mjs",
    "prebuild": "npm run verify:captures",
    "dev:ui": "astro dev",
    "build": "astro build",
    "dev": "npm run build && wrangler dev --port 8790",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test worker/index.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/inter": "5.2.8",
    "astro": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.148.0"
  }
}
