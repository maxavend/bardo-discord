{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "src"],
  "exclude": ["dist"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": false,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}
