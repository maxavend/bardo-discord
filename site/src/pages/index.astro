---
// Static HTML; the live meeting hydrates on load. Other controls hydrate in
// idle time, so keyboard navigation and direct section links stay usable.
import Layout from '@/layouts/Layout.astro';
import { LiveMeetingDemo } from '@/components/demo/LiveMeetingDemo';
import { AgreementsDemo } from '@/components/demo/AgreementsDemo';
import { SpacesShowcase } from '@/components/SpacesShowcase';
import { Shot } from '@/components/Shot';
import Footer from '@/components/Footer.astro';
import BrandMark from '@/components/BrandMark.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { INSTALL_URL, container, h2, lead, navCta, primaryCta, quietCta } from '@/lib/site';
import { cn } from '@/lib/utils';

const WHERE = [
  ['Discord en escritorio y navegador', 'Disponible'],
  ['Discord en el móvil', 'Disponible'],
  ['Bardo en la web, con tu cuenta', 'En preparación'],
];
---
<Layout
  title="Bardo: documentos, reuniones y tareas en Discord"
  description="Documentos, reuniones y tareas dentro de tu canal de Discord, sin abrir otra herramienta."
>
  <a href="#contenido" class="fixed top-4 left-4 z-50 -translate-y-[200%] rounded-full bg-foreground px-4 py-2 text-background focus-visible:translate-y-0">
    Saltar al contenido
  </a>

  <header class={cn(container, 'site-header flex min-h-18 items-center justify-between gap-6')}>
    <a href="/" aria-label="Bardo, inicio" class="site-brand inline-flex rounded-sm">
      <BrandMark />
    </a>
    <nav aria-label="Principal" class="flex items-center gap-2 sm:gap-6">
      <a href="#web" class="text-sm text-secondary-foreground underline-offset-4 hover:text-primary hover:underline active:text-primary max-lg:hidden">Versión web</a>
      <a href={INSTALL_URL} class={navCta}>Agregar a Discord</a>
      <ThemeToggle />
    </nav>
  </header>

  <main id="contenido" class="site-home">
    <!-- Hero: Banner, the text on five columns, the live meeting on seven. -->
    <section data-entry-reveal aria-labelledby="hero-title" class={cn(container, 'site-hero grid items-center gap-x-24 gap-y-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]')}>
      <div data-motion-group class="grid gap-6">
        <h1 data-motion-item id="hero-title" class="max-w-[12ch] text-[clamp(2.75rem,3.6vw+0.75rem,4.25rem)] leading-[1.04]">
          Lo hablado en Discord queda escrito<span class="text-punto">.</span>
        </h1>
        <p data-motion-item class={cn(lead, 'max-w-[34ch]')}>Documentos, reuniones y tareas dentro de tu canal, sin abrir otra herramienta.</p>
        <div data-motion-item class="hero-actions mt-2 flex flex-wrap gap-3">
          <a href={INSTALL_URL} class={primaryCta}>Agregar a Discord</a>
          <a href="#web" class={quietCta}>Ver disponibilidad</a>
        </div>
      </div>
      <figure data-motion-reveal class="m-0">
        <LiveMeetingDemo client:load />
        <figcaption class="mt-3 text-sm text-muted-foreground">Datos de ejemplo. Prueba Siguiente tema.</figcaption>
      </figure>
    </section>

    <!-- Three alternating product stories in normal page flow. -->
    <section aria-labelledby="spaces-title" class="spaces-section relative py-24 lg:py-32">
      <div class={container}><SpacesShowcase /></div>
    </section>

    <!-- The signature: agreements that become tasks. -->
    <section aria-labelledby="agreements-title" class="bg-paper py-30">
      <div class={cn(container, 'grid items-center gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]')}>
        <div data-motion-group class="grid content-center gap-6">
          <h2 data-motion-item id="agreements-title" class={h2}>Cada acuerdo, con responsable<span class="heading-stop">.</span></h2>
          <p data-motion-item class={lead}>Al cerrar la reunión, los acuerdos pasan al tablero en un paso.</p>
        </div>
        <figure data-motion-reveal class="m-0 lg:mx-auto lg:w-full lg:max-w-[40rem]">
          <AgreementsDemo client:idle={{timeout: 500}} />
          <figcaption class="mt-3 text-sm text-muted-foreground">Datos de ejemplo. Desmarca un acuerdo y crea las tareas.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Where Bardo runs today and the status of the web version. -->
    <section id="web" aria-labelledby="where-title" class={cn(container, 'site-availability grid items-center justify-between gap-x-16 gap-y-12 pt-24 pb-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)]')}>
      <div data-motion-group class="grid gap-8">
        <h2 data-motion-item id="where-title" class={h2}>Hoy en Discord, pronto en tu navegador<span class="heading-stop">.</span></h2>
        <table data-motion-item class="w-full border-collapse">
          <caption class="sr-only">Dónde funciona Bardo</caption>
          <thead>
            <tr class="text-left text-sm text-muted-foreground">
              <th scope="col" class="pb-3 font-normal">Dónde</th>
              <th scope="col" class="pb-3 text-right font-normal">Estado</th>
            </tr>
          </thead>
          <tbody>
            {WHERE.map(([where, state], index) => (
              <tr class="border-t border-border">
                <th scope="row" class="py-4 text-left font-semibold">{where}</th>
                <td class={cn('py-4 pl-4 text-right whitespace-nowrap', index === WHERE.length - 1 ? 'text-primary' : 'text-secondary-foreground')}>{state}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div data-motion-reveal class="w-full max-w-[22rem] justify-self-end max-lg:justify-self-start"><Shot
        name="09-tablero"
        device="mobile"
        frame="phone"
        phone={false}
        alt="El tablero de tareas de Bardo en Discord para móvil"
        className="w-full"
      /></div>
    </section>

    <!-- Close: the action again, beside one last screen. -->
    <section aria-labelledby="close-title" class="site-close pt-12 pb-24">
      <div class={cn(container, 'grid items-center gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]')}>
        <div data-motion-group class="grid gap-6">
          <h2 data-motion-item id="close-title" class={h2}>Abre Bardo en tu canal<span class="heading-stop">.</span></h2>
          <p data-motion-item class={lead}>Agrégalo a tu servidor y escribe /bardo en cualquier canal.</p>
          <div data-motion-item><a href={INSTALL_URL} class={primaryCta}>Agregar a Discord</a></div>
          <p data-motion-item class="text-sm text-muted-foreground">Para agregarlo necesitas el permiso Gestionar servidor.</p>
        </div>
        <div data-motion-reveal><Shot name="07-resumen" frame="monitor" alt="El recap de una reunión en Bardo con sus acuerdos, responsables y tiempos" /></div>
      </div>
    </section>
  </main>

  <Footer />
  <script>
    import '@/lib/scroll-motion';
    import '@/lib/shot-loading';
  </script>
</Layout>
