{
  "name": "bardo-docs-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assemble": "node scripts/assemble-source.mjs",
    "dev": "npm run assemble && vite",
    "build": "npm run assemble && vite build",
    "preview": "vite preview",
    "lint": "npm run assemble && eslint src --max-warnings=0",
    "typecheck": "npm run assemble && tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=laptop --project=mobile-narrow --project=mobile-standard --forbid-only"
  },
  "dependencies": {
