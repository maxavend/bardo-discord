    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
