    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "5.2.8",
    "@gravity-ui/icons": "2.21.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/link": "^53.3.5",
    "@platejs/list": "^53.1.3",
    "@platejs/table": "^53.0.9",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.38.0",
    "mammoth": "^1.12.1",
    "motion": "^13.2.0",
    "platejs": "^53.3.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
