{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bardo-discord",
  "workers_dev": true,
  // Do not expose older versions with production bindings through preview URLs.
  "preview_urls": false,
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "DISCORD_PUBLIC_KEY",
      "DISCORD_TOKEN",
      "DISCORD_CLIENT_SECRET"
    ]
  },
  "assets": {
    "directory": "./activity",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/auth/*",
      "/oauth/*",
      "/mcp",
      "/.well-known/*"
    ]
  },
  // Bardo en el navegador y servidor MCP: apagados hasta configurar la variable
  // WEB_ORIGIN (por ejemplo https://bardo-discord.bardo-discord.workers.dev).
  // Pasos en DEPLOYMENT.md, sección «Web y MCP». El deploy usa --keep-vars.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bardo-db",
      "database_id": "db89af73-dc24-491e-bf57-975f7bd6c085",
      "migrations_dir": "migrations"
    }
  ],
  // Approximate per-location abuse limits, shared between Worker instances.
  // Namespace IDs are reserved for Bardo in this account; keep them unique.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1539704001", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1539704002", "simple": { "limit": 300, "period": 60 } },
    { "name": "INTERACTION_RATE_LIMITER", "namespace_id": "1539704003", "simple": { "limit": 60, "period": 60 } }
  ],
  // Daily housekeeping handled by `scheduled()` in src/worker.js: removes
  // expired auth sessions, stale launch intents and old Activity contexts.
  // It never deletes documents, ACLs or meetings. (The former "*/5 * * * *"
  // trigger had no work to do and only produced failed invocations.)
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
