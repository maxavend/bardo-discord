{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bardo-discord",
  "main": "src/conversation-entry.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_MAX_OUTPUT_TOKENS": "700",
    "AI_RATE_LIMIT": "20",
    "BARDO_TIMEZONE": "America/Santiago"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./activity",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bardo-db",
      "database_id": "db89af73-dc24-491e-bf57-975f7bd6c085",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "bardo-backups"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/5 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "bardo-discord-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BARDO_STAGING_RESOURCE_STATE": "unprovisioned",
        "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
        "AI_MAX_OUTPUT_TOKENS": "700",
        "AI_RATE_LIMIT": "20",
        "BARDO_TIMEZONE": "America/Santiago"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bardo-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BACKUPS",
          "bucket_name": "bardo-backups-staging"
        }
      ],
      "triggers": {
        "crons": []
      }
    },
    "production": {
      "name": "bardo-discord",
      "vars": {
        "ENVIRONMENT": "production",
        "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
        "AI_MAX_OUTPUT_TOKENS": "700",
        "AI_RATE_LIMIT": "20",
        "BARDO_TIMEZONE": "America/Santiago"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bardo-db",
          "database_id": "db89af73-dc24-491e-bf57-975f7bd6c085",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BACKUPS",
          "bucket_name": "bardo-backups"
        }
      ],
      "triggers": {
        "crons": [
          "0 3 * * *",
          "*/5 * * * *"
        ]
      }
    }
  }
}
