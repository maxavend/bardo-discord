    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "mammoth": "^1.12.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
