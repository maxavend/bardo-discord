@import "tailwindcss";
@import "@heroui/styles";

:root {
  color-scheme: dark;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
  --bardo-topbar: 52px;
  --bardo-toolbar-gap: 16px;
  --bardo-content: 690px;
}

* { box-sizing: border-box; }
html, body, #root { margin: 0; width: 100%; min-height: 100%; }
html { background: var(--background); overflow-x: clip; scroll-padding-top: 72px; }
body { min-height: 100dvh; background: var(--background); color: var(--foreground); overflow-x: clip; overscroll-behavior-x: none; touch-action: pan-y; }
button, input, select { font: inherit; }
button { color: inherit; }
.app-root { min-height: 100dvh; background: var(--background); color: var(--foreground); }
.route-active { min-height: 100dvh; }

.glass-header {
  background: color-mix(in oklab, var(--background) 72%, transparent);
  backdrop-filter: blur(14px) saturate(135%);
  -webkit-backdrop-filter: blur(14px) saturate(135%);
}

/* Library */
.library { width: 100%; padding: 0 16px max(84px, calc(env(safe-area-inset-bottom) + 68px)); }
.library-inner { width: min(100%, 760px); margin: 0 auto; }
.library-header {
  position: sticky; top: 0; z-index: 40;
  height: var(--bardo-topbar);
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 -4px; padding: 0 4px;
}
.library-title { font-size: 18px; font-weight: 760; letter-spacing: -0.025em; }
.header-actions { display: flex; align-items: center; gap: 2px; }
.new-button { min-height: 44px; padding-inline: 10px; }

.search-wrap { position: relative; margin: 22px 0 32px; }
.search-leading { position: absolute; left: 14px; top: 50%; z-index: 2; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
.search-input { width: 100%; height: 48px; padding-left: 42px !important; font-size: 16px !important; }

.library-section { margin-top: 40px; }
.continue-section { margin-top: 0; }
.section-title { margin: 0 0 12px; color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .01em; }
.continue-row {
  width: 100%; border: 0; background: transparent; padding: 12px 0 18px;
  display: grid; grid-template-columns: 4px minmax(0, 1fr) 24px; gap: 14px; align-items: center;
  text-align: left; cursor: pointer; border-bottom: 1px solid var(--separator);
}
.continue-accent { width: 4px; height: 44px; border-radius: 999px; background: var(--default); }
.continue-copy { min-width: 0; }
.continue-copy strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; line-height: 1.35; font-weight: 700; }
.continue-copy span { display: block; margin-top: 5px; color: var(--muted); font-size: 13px; }

.recent-section { margin-top: 42px; }
.docs-list { border-top: 1px solid var(--separator); }
.doc-row {
  min-height: 72px; display: grid; grid-template-columns: 30px minmax(0,1fr) 44px; gap: 10px; align-items: center;
  border-bottom: 1px solid var(--separator);
}
.doc-symbol { display: grid; place-items: center; color: var(--muted); }
.doc-row-main { min-width: 0; min-height: 71px; border: 0; background: transparent; text-align: left; padding: 11px 0; cursor: pointer; }
.doc-row-main strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; font-weight: 690; line-height: 1.35; }
.doc-row-main span { display: block; margin-top: 5px; color: var(--muted); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.empty-state { padding: 48px 8px; text-align: center; color: var(--muted); font-size: 14px; }

/* Native OS menus. The select itself owns the interaction, the dots are purely visual. */
.native-menu { position: relative; width: 44px; height: 44px; flex: 0 0 44px; display: inline-grid; place-items: center; border-radius: 10px; color: var(--muted); }
.native-menu-visual { font-size: 18px; line-height: 1; letter-spacing: 2px; transform: translateY(-2px); }
.native-menu select { position: absolute; inset: 0; width: 44px; height: 44px; opacity: 0; appearance: auto; -webkit-appearance: menulist; cursor: pointer; }
.native-menu:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }

/* Reader + editor */
.doc-route { width: 100%; background: var(--background); }
.doc-topbar {
  position: sticky; top: 0; z-index: 60;
  height: var(--bardo-topbar); padding: 0 10px;
  display: grid; grid-template-columns: minmax(88px,1fr) auto minmax(88px,1fr); align-items: center;
}
.topbar-left { justify-self: start; display: flex; align-items: center; min-width: 0; }
.topbar-center { justify-self: center; color: var(--muted); font-size: 12px; white-space: nowrap; }
.topbar-right { justify-self: end; display: flex; align-items: center; gap: 2px; min-width: 0; }
.back-button { min-height: 44px; margin-left: -8px; padding-inline: 6px 10px; }
.save-state[data-dirty="true"] { color: var(--warning); }

.document-shell { width: min(var(--bardo-content), calc(100% - 32px)); margin: 0 auto; padding: 20px 0 max(104px, calc(env(safe-area-inset-bottom) + 84px)); }
.doc-intro { display: grid; align-items: start; }
.doc-title {
  margin: 0; color: var(--foreground); font-size: clamp(34px, 9.2vw, 48px); font-weight: 770; line-height: 1.055; letter-spacing: -0.047em; overflow-wrap: anywhere;
}
.doc-description { max-width: 620px; margin: 12px 0 0; color: color-mix(in oklab, var(--foreground) 72%, var(--muted)); font-size: 16px; line-height: 1.55; letter-spacing: -0.008em; }
.doc-meta { margin-top: 18px; color: var(--muted); font-size: 13px; line-height: 1.45; }

.doc-title-input, .doc-description-input {
  width: 100%; border: 0; outline: none; box-shadow: none; background: transparent; padding: 0; border-radius: 0; color: inherit; appearance: none;
}
.doc-title-input::placeholder { color: color-mix(in oklab, var(--foreground) 30%, transparent); }
.doc-description-input::placeholder { color: color-mix(in oklab, var(--muted) 75%, transparent); }

.doc-body { margin-top: 40px; color: color-mix(in oklab, var(--foreground) 82%, var(--muted)); font-size: 16px; line-height: 1.72; outline: none; overflow-wrap: anywhere; word-break: normal; }
.doc-body > :first-child { margin-top: 0; }
.doc-body h2 { margin: 40px 0 12px; color: var(--foreground); font-size: 1.38rem; line-height: 1.25; font-weight: 730; letter-spacing: -0.025em; }
.doc-body h3 { margin: 32px 0 10px; color: var(--foreground); font-size: 1.12rem; line-height: 1.3; font-weight: 700; }
.doc-body p { margin: 14px 0; }
.doc-body ul, .doc-body ol { padding-left: 1.4em; margin: 16px 0 20px; }
.doc-body li { margin: 7px 0; }
.doc-body blockquote { margin: 24px 0; padding-left: 16px; border-left: 2px solid var(--border); color: color-mix(in oklab, var(--foreground) 72%, var(--muted)); }
.doc-body hr { border: 0; height: 1px; background: var(--separator); margin: 36px 0; }
.doc-body code { font-family: "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace; font-size: .9em; back