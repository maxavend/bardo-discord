ground: var(--surface-secondary); border-radius: 5px; padding: .12em .32em; }
.doc-body a { color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
.doc-body del, .doc-body s { color: var(--muted); }
.doc-body pre { width: 100%; max-width: 100%; margin: 24px 0; padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-secondary); color: var(--foreground); font: 13px/1.6 "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; overflow: hidden; }
.doc-body pre code { padding: 0; background: transparent; color: inherit; font: inherit; }
.doc-body .doc-callout { margin: 24px 0; padding: 14px 15px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-secondary); color: color-mix(in oklab, var(--foreground) 80%, var(--muted)); }
.doc-body table { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 24px 0; font-size: 14px; }
.doc-body th, .doc-body td { padding: 10px; border: 1px solid var(--border); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
.doc-body th { color: var(--foreground); background: var(--surface-secondary); font-weight: 680; }
.doc-body td { color: color-mix(in oklab, var(--foreground) 78%, var(--muted)); }
.doc-body kbd { font: .8em "SFMono-Regular", ui-monospace, monospace; padding: .14em .4em; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 5px; background: var(--surface-secondary); color: var(--foreground); }

.doc-body .spoiler { margin: 24px 0; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-secondary); overflow: clip; }
.doc-body .spoiler summary { min-height: 46px; display: flex; align-items: center; gap: 8px; padding: 0 14px; color: var(--foreground); font-size: 14px; font-weight: 680; cursor: pointer; list-style: none; }
.doc-body .spoiler summary::-webkit-details-marker { display: none; }
.doc-body .spoiler summary::before { content: "›"; color: var(--muted); font-size: 20px; line-height: 1; transition: transform .15s ease; }
.doc-body .spoiler[open] summary::before { transform: rotate(90deg); }
.doc-body .spoiler[open] summary { border-bottom: 1px solid var(--separator); }
.doc-body .spoiler > :not(summary) { margin-left: 14px; margin-right: 14px; }
.doc-body .spoiler > :last-child { margin-bottom: 14px; }

.doc-body .checklist { list-style: none; padding-left: 0; margin: 18px 0 22px; }
.doc-body .checklist li { position: relative; min-height: 40px; padding: 8px 0 8px 42px; margin: 1px 0; }
.doc-body .checklist li.done { color: var(--muted); text-decoration: line-through; }
.check-control { position: absolute; left: 0; top: 0; width: 40px; height: 40px; border: 0; background: transparent; display: grid; place-items: center; cursor: pointer; color: transparent; }
.check-control::before { content: ""; position: absolute; width: 18px; height: 18px; border: 1px solid var(--border); border-radius: 5px; background: var(--surface-secondary); }
.check-control span { position: relative; z-index: 1; font-size: 12px; font-weight: 800; }
.checklist li.done > .check-control { color: var(--foreground); }
.checklist li.done > .check-control::before { background: var(--default); border-color: var(--default); }

/* Toolbar */
.editor-shell .doc-body { margin-top: 40px; }
.editor-toolbar-sticky { position: sticky; top: calc(var(--bardo-topbar) + var(--bardo-toolbar-gap)); z-index: 50; margin-top: 24px; width: 100%; pointer-events: none; background: transparent; }
.editor-toolbar { pointer-events: auto; width: min(100%, 590px); min-height: 52px; display: flex; align-items: center; gap: 2px; padding: 4px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); box-shadow: none; }
.block-select { width: 108px; flex: 0 0 108px; }
.block-select-trigger { min-height: 44px !important; border-radius: 10px !important; box-shadow: none !important; }
.toolbar-button { width: 44px !important; min-width: 44px !important; height: 44px !important; min-height: 44px !important; padding: 0 !important; }
.toolbar-separator { width: 1px; height: 22px; background: var(--separator); margin: 0 2px; flex: 0 0 auto; }
.toolbar-native-menu { color: var(--foreground); }
.editable-body { min-height: 45vh; }
.editable-body:empty::before { content: attr(data-placeholder); color: var(--muted); pointer-events: none; }

/* Feedback and modal copy */
.toast { position: fixed; z-index: 200; left: 50%; bottom: max(18px, env(safe-area-inset-bottom)); transform: translate(-50%, 12px); padding: 9px 13px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--foreground); font-size: 13px; opacity: 0; pointer-events: none; transition: opacity .16s ease, transform .16s ease; white-space: nowrap; max-width: calc(100% - 32px); overflow: hidden; text-overflow: ellipsis; }
.toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
.missing-state { min-height: 70vh; display: grid; place-content: center; justify-items: center; gap: 16px; padding: 24px; color: var(--muted); text-align: center; }

@media (min-width: 760px) {
  .library { padding-left: 28px; padding-right: 28px; }
  .document-shell { padding-top: 30px; }
  .editor-toolbar-sticky { margin-top: 28px; }
}

@media (max-width: 520px) {
  .library { padding-left: 14px; padding-right: 14px; }
  .document-shell { width: calc(100% - 28px); padding-top: 18px; }
  .doc-topbar { padding-inline: 8px; }
  .editor-toolbar { width: 100%; }
  .block-select { width: 98px; flex-basis: 98px; }
  .toolbar-separator { display: none; }
}

@media (max-width: 360px) {
  .block-select { width: 88px; flex-basis: 88px; }
  .optional-bullets { display: none !important; }
  .editor-toolbar { gap: 1px; }
  .doc-title { font-size: 32px; }
}

@media (hover: hover) and (pointer: fine) {
  .doc-row-main:hover strong, .continue-row:hover strong { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .native-menu:hover { background: var(--surface-secondary); color: var(--foreground); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .001ms !important; animation-duration: .001ms !important; }
}

@media print {
  .doc-topbar, .editor-toolbar-sticky, .toast { display: none !important; }
  .document-shell { width: 100%; max-width: none; padding: 0; }
  body, .app-root, .doc-route { background: white !important; color: black !important; }
  .doc-title, .doc-body h2, .doc-body h3 { color: black !important; }
  .doc-description, .doc-meta, .doc-body { color: #333 !important; }
}
